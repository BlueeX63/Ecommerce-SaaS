# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Applies repo-wide: this is a three-project workspace (frontend/, backend/, super-admin/), so patterns
# are NOT root-anchored unless noted, so they also match inside those subdirectories.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/Architecture

# testing
coverage/

# next.js (frontend/)
.next/
out/

# node backend build output
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets; copy from .env.example instead)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
