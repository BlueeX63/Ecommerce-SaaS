# Shared secret the main backend must send as "Authorization: Bearer <token>" on every /v1 call.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=

# Base URL of the main backend. Used ONLY to execute store tools (search products, add to cart) with the
# short-lived tool token the backend issues per request. Never exposed to browsers.
BACKEND_INTERNAL_URL=http://localhost:4000

# Provider keys live here and nowhere else. A /v1 route answers 503 while its key is unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_TEXT_MODEL=claude-sonnet-5-5
AI_IMAGE_MODEL=gpt-image-2
AI_REALTIME_MODEL=gpt-realtime-2.1

# Capacity guards. Requests beyond these wait up to QUEUE_TIMEOUT_SECONDS, then get a fast 503.
MAX_CONCURRENT_TEXT=64
MAX_CONCURRENT_IMAGES=4
QUEUE_TIMEOUT_SECONDS=20
PORT=8000
LOG_LEVEL=info
