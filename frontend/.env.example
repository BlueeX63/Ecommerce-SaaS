# Copy to frontend/.env.local and fill in real values. Never commit the filled-in file.
# Only PUBLIC values belong here - server-side secrets live in backend/.env.

# Where the Next.js server proxies /api/* requests to (see next.config.ts).
BACKEND_URL=http://localhost:4100

# DEV ONLY: use a fake OTP for storefront sign-up instead of real Firebase phone verification.
# The backend must also run with ALLOW_DUMMY_OTP=true.
NEXT_PUBLIC_DUMMY_OTP=false

# DEV ONLY: skip Stripe on the merchant checkout page and activate the plan directly.
# The backend must also run with ALLOW_MOCK_SUBSCRIBE=true. Turn both off before deploying.
NEXT_PUBLIC_TEST_PAYMENTS=false

# Base SaaS domain used for subdomain routing, e.g. your-saas.com (a store then lives at slug.your-saas.com).
# NEXT_PUBLIC_ROOT_DOMAIN=

# Supabase (only used client-side for Google OAuth sign-in)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key (Checkout redirect happens server-side; this is currently unused client-side
# but kept for future embedded payment elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Firebase Web SDK config (storefront phone-number sign-up)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
