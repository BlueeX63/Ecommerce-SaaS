# Copy to backend/.env and fill in real values. Never commit the filled-in file.

NODE_ENV=development
PORT=4100
TRUST_PROXY_HOPS=1

# Public URL of the frontend (used in e-mail links and Stripe redirect URLs) and the SaaS base domain.
FRONTEND_URL=http://localhost:3000
# ROOT_DOMAIN=your-saas.com

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs merchant + shopper session cookies. Generate with: openssl rand -hex 32
JWT_SECRET=

# Stripe (merchant subscription billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upstash Redis (rate limiting, OTP codes, caching). Falls back to an in-memory store in development only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (registration OTP + password reset e-mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase Admin (verifies shopper phone-number OTP at storefront sign-up)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# DEV ONLY. The server refuses to start with either of these set to true when NODE_ENV=production.
ALLOW_DUMMY_OTP=false
ALLOW_MOCK_SUBSCRIBE=false

# AI features (optional). Keys stay server-side. Endpoints answer 503 while the key is unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_TEXT_MODEL=claude-sonnet-5-5
AI_IMAGE_MODEL=gpt-image-2
AI_REALTIME_MODEL=gpt-realtime-2.1
